---
/* Muestra la foto si el archivo existe en src/assets/imagenes/.
   Si no existe, muestra un bloque de color con las iniciales. */
import { Image } from 'astro:assets';
import { buscarFoto } from '../lib/fotos';

interface Props {
  archivo: string;
  alt: string;
  iniciales: string;
  tono?: 1 | 2 | 3 | 4 | 5;
  proporcion?: string;
  anchos?: number[];
  sizes?: string;
  prioridad?: boolean;
  /** La foto se desplaza levemente al hacer scroll. */
  paralaje?: boolean;
}

const {
  archivo,
  alt,
  iniciales,
  tono = 1,
  proporcion = '4 / 5',
  anchos = [320, 640, 960],
  sizes = '(min-width: 900px) 33vw, 90vw',
  prioridad = false,
  paralaje = false,
} = Astro.props;

const foto = buscarFoto(archivo);
---

<div class="foto-caja" style={`aspect-ratio: ${proporcion}`}>
  {
    foto ? (
      <Image
        class="foto foto--real"
        src={foto}
        alt={alt}
        widths={anchos}
        sizes={sizes}
        loading={prioridad ? 'eager' : 'lazy'}
        fetchpriority={prioridad ? 'high' : undefined}
        data-paralaje={paralaje ? '' : undefined}
      />
    ) : (
      <div class={`foto foto--marcador foto--tono-${tono}`} role="img" aria-label={`${alt} (foto pendiente)`}>
        <span aria-hidden="true">{iniciales}</span>
      </div>
    )
  }
</div>
