---
import '@fontsource-variable/inter/index.css';
import '../styles/global.css';
import '../styles/movimiento.css';
// La tipografía se precarga para que el título no cambie de forma al cargar.
import interLatina from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import { sitio, type IdPagina } from '../data/sitio';
import Apertura from '../components/Apertura.astro';
import Cabecera from '../components/Cabecera.astro';
import Miga from '../components/Miga.astro';
import Pie from '../components/Pie.astro';
import Seo from '../components/Seo.astro';
import Siguiente from '../components/Siguiente.astro';

interface Props {
  /** Título de la pestaña. Vacío en la portada. */
  titulo?: string;
  descripcion?: string;
  /** Página actual: define cuál es la "siguiente" al final. */
  actual?: IdPagina;
  /** Muestra el llamado grande a pedir turno en el pie. */
  conLlamado?: boolean;
  noIndexar?: boolean;
}

const { titulo, descripcion = sitio.descripcion, actual, conLlamado = true, noIndexar = false } = Astro.props;

// Las páginas internas llevan la barra de ubicación; la portada y la 404, no.
const conMiga = Boolean(titulo) && !noIndexar;

const paso = {
  old: { name: 'pagina-sale', duration: '0.6s', easing: 'cubic-bezier(0.7, 0, 0.2, 1)', fillMode: 'both' },
  new: { name: 'pagina-entra', duration: '0.6s', easing: 'cubic-bezier(0.7, 0, 0.2, 1)', fillMode: 'both' },
};
const transicion = { forwards: paso, backwards: paso };
---

<!doctype html>
<html lang="es-AR" transition:animate={transicion}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo titulo={titulo} descripcion={descripcion} noIndexar={noIndexar} />
    <meta name="theme-color" content="#f3eee4" />
    <link rel="preload" href={interLatina} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <script is:inline>
      (() => {
        const raiz = document.documentElement;
        raiz.classList.add('js');
        // Apertura: solo la primera vez que se entra al sitio en la sesión.
        try {
          const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!quieto && !sessionStorage.getItem('apertura')) {
            sessionStorage.setItem('apertura', '1');
            raiz.classList.add('intro');
          }
        } catch (e) {}
        document.addEventListener('astro:after-swap', () => raiz.classList.add('js'));
      })();
    </script>
  </head>
  <body>
    <Apertura />
    <a class="saltar" href="#contenido">Ir al contenido</a>
    <Cabecera />
    {conMiga && titulo && <Miga titulo={titulo} />}
    <main id="contenido">
      <slot />
      {actual && <Siguiente actual={actual} />}
    </main>
    <Pie conLlamado={conLlamado} />
    {/* Vercel Web Analytics: va en el <body> para que, con ClientRouter, cada
        navegación entre páginas cuente como una visita nueva. */}
    <Analytics />
    <script>
      import '../scripts/sitio.ts';
    </script>
  </body>
</html>
