---
import Base from '../layouts/Base.astro';
import Folio from '../components/Folio.astro';
import Seccion from '../components/Seccion.astro';
import Rodillo from '../components/Rodillo.astro';
import { pagina } from '../data/sitio';
import { formacion } from '../data/formacion';

const p = pagina('formacion');
---

<Base titulo={p.nombre} descripcion={p.descripcion} actual="formacion">
  <Folio numero={p.numero} nombre={p.nombre} titulo={p.titulo} enfasis={p.enfasis} intro={formacion.intro} />

  <section class="tiempo" aria-labelledby="tiempo-titulo">
    <div class="marco">
      <h2 class="solo-lectores" id="tiempo-titulo">Línea de tiempo</h2>
      <div class="tiempo__via">
        <ol class="tiempo__lista" data-tiempo>
          {
            formacion.lineaDeTiempo.map((h) => (
              <li class="hito" data-hito>
                <p class="hito__anio" data-aparece>
                  <time class="hito__desde" datetime={h.anio}>
                    <Rodillo texto={h.anio} />
                  </time>
                  {h.hasta && <span class="hito__hasta etiqueta">hasta {h.hasta}</span>}
                  {h.enCurso && <span class="hito__hasta etiqueta">Actualidad</span>}
                </p>
                <span class="hito__nodo" data-nodo aria-hidden="true" />
                <div class="hito__cuerpo tarjeta" data-aparece style="--i:1">
                  <p class="hito__tipo etiqueta">{h.tipo}</p>
                  <h3 class="titulo-m">{h.titulo}</h3>
                  <p class="hito__inst">{h.institucion}</p>
                  {h.detalle && <p class="texto chico tenue">{h.detalle}</p>}
                </div>
              </li>
            ))
          }
        </ol>
        <p class="tiempo__hoy etiqueta" data-aparece>Hoy</p>
      </div>
    </div>
  </section>

  <Seccion numero={`${p.numero}.1`} titulo="Cursos y actualizaciones" id="cursos" suave>
    <ul class="filas tabla">
      {
        formacion.cursos.map((c, i) => (
          <li class="tabla__fila fila-viva" data-aparece data-linea style={`--i:${i % 5}`}>
            <time class="tabla__anio" datetime={c.anio}>
              <Rodillo texto={c.anio} />
            </time>
            <span class="tabla__nombre titulo-s">{c.nombre}</span>
            <span class="tabla__inst tenue chico">{c.institucion}</span>
          </li>
        ))
      }
    </ul>
  </Seccion>

  <Seccion numero={`${p.numero}.2`} titulo="Certificaciones" id="certificaciones">
    <ul class="certs">
      {
        formacion.certificaciones.map((c, i) => (
          <li class="cert tarjeta" data-aparece style={`--i:${i % 3}`}>
            <svg class="cert__sello" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true">
              <circle cx="24" cy="24" r="21" pathLength="1" />
              <path d="M15 24.5l6.2 6.2L33.5 18" pathLength="1" />
            </svg>
            <h3 class="titulo-s">{c.nombre}</h3>
            <p class="tenue chico">{c.entidad}</p>
            <p class="cert__vigencia chip">Vigencia {c.vigencia}</p>
          </li>
        ))
      }
    </ul>
  </Seccion>

  <Seccion numero={`${p.numero}.3`} titulo="Sociedades científicas" id="sociedades">
    <ul class="sociedades">
      {
        formacion.sociedades.map((s, i) => (
          <li class="sociedad" data-aparece style={`--i:${i * 2}`}>
            <span class="sociedad__punto" aria-hidden="true" />
            {s}
          </li>
        ))
      }
    </ul>
  </Seccion>
</Base>

<style>
  /* ---------- Línea de tiempo ----------
     Eje vertical con un pulso que baja con el scroll. Cada hito es una tarjeta
     que entra desde el costado; el año entra rodando dígito por dígito. */
  .tiempo {
    padding-bottom: var(--aire);
    overflow-x: clip;
  }

  .tiempo__via {
    --pad: clamp(1.5rem, 2.6vw, 2.5rem);
    --anio: clamp(2.75rem, 5vw, 4.5rem);
    --sep: clamp(1.5rem, 4vw, 4rem);
    /* Posición horizontal del eje y altura del nodo dentro de cada hito. */
    --eje: calc((100% + var(--canal)) / 12 * 5 - var(--canal) / 2);
    --nodo-y: calc(var(--pad) + 0.9rem + var(--anio) * 0.4);
  }

  .tiempo__lista {
    position: relative;
  }

  /* Trazo de acento: crece desde el primer nodo hasta el centro de la pantalla. */
  .tiempo__lista::after {
    content: '';
    position: absolute;
    top: var(--nodo-y);
    bottom: 0;
    left: var(--eje);
    width: 1px;
    background: var(--acento);
    transform: scaleY(0);
    transform-origin: top center;
    pointer-events: none;
  }

  /* El pulso: un punto que late en la punta del trazo. */
  .tiempo__lista::before {
    content: '';
    position: absolute;
    z-index: 2;
    top: var(--nodo-y);
    left: var(--eje);
    display: none;
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5px;
    border-radius: 50%;
    background: var(--acento);
    pointer-events: none;
  }

  @keyframes tiempo-baja {
    to {
      top: 100%;
    }
  }

  @keyframes tiempo-halo {
    0% {
      box-shadow:
        0 0 0 0 rgba(168, 69, 42, 0.5),
        0 0 0 0 rgba(168, 69, 42, 0.28);
    }

    70%,
    100% {
      box-shadow:
        0 0 0 10px rgba(168, 69, 42, 0),
        0 0 0 22px rgba(168, 69, 42, 0);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* La línea de tiempo se mide contra el centro de la pantalla. El trazo y el
         pulso empiezan en el primer nodo, así la punta coincide siempre con el centro. */
      .tiempo__lista {
        view-timeline: --tiempo block;
        view-timeline-inset: 50% 50%;
      }

      .tiempo__lista::after {
        animation: crecer linear both;
        animation-timeline: --tiempo;
        animation-range: var(--nodo-y) 100%;
      }

      .tiempo__lista::before {
        display: block;
        animation:
          tiempo-baja linear both,
          tiempo-halo 1.6s ease-out infinite;
        animation-timeline: --tiempo, auto;
        animation-range: var(--nodo-y) 100%, normal;
      }
    }
  }

  .hito {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--canal);
    align-items: start;
    padding-block: var(--pad);
  }

  /* La línea vertical: un tramo por hito, así queda continua. */
  .hito::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--eje);
    width: 1px;
    background: var(--linea);
  }

  .hito:first-child::before {
    top: var(--nodo-y);
  }

  .hito__nodo {
    position: absolute;
    top: var(--nodo-y);
    left: var(--eje);
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5px;
    border: 1px solid var(--tinta-2);
    border-radius: 50%;
    background: var(--marfil);
    transition:
      background-color 0.5s ease,
      border-color 0.5s ease,
      box-shadow 0.5s ease;
  }

  /* Conector entre el nodo y la tarjeta: se dibuja cuando la tarjeta entra. */
  .hito__nodo::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(100% + 1px);
    width: calc(var(--sep) - 7px);
    height: 1px;
    background: var(--linea);
    transform-origin: left center;
    transition:
      transform 0.7s var(--curva) 0.25s,
      background-color 0.5s ease;
  }

  /* Onda que se expande desde el nodo del hito activo. */
  .hito__nodo::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid var(--acento);
    border-radius: 50%;
    opacity: 0;
  }

  .hito__anio {
    grid-column: 1 / 6;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding-top: 0.9rem;
    padding-right: var(--sep);
    text-align: right;
  }

  .hito__desde {
    font-weight: 300;
    font-size: var(--anio);
    line-height: 0.8;
    letter-spacing: -0.05em;
    font-variant-numeric: lining-nums tabular-nums;
    /* Los años todavía no alcanzados quedan apagados. */
    color: color-mix(in srgb, var(--tinta) 26%, var(--marfil));
    transition: color 0.7s ease;
  }

  .hito__hasta {
    color: var(--tinta-2);
  }

  .hito__cuerpo {
    grid-column: 6 / -1;
    margin-left: var(--sep);
    gap: 0.7rem;
  }

  .hito__cuerpo h3 {
    max-width: 18em;
  }

  .hito__inst {
    max-width: 32em;
  }

  .hito__tipo {
    color: var(--tinta-2);
    transition: color 0.6s ease;
  }

  /* --- Estados que marca el script --- */
  .hito.recorrido .hito__desde {
    color: var(--tinta);
  }

  .hito.recorrido .hito__nodo {
    background: var(--acento);
    border-color: var(--acento);
  }

  .hito.activo .hito__desde,
  .hito.activo .hito__tipo {
    color: var(--acento);
  }

  .hito.activo .hito__nodo {
    background: var(--acento);
    border-color: var(--acento);
    box-shadow: 0 0 0 5px rgba(168, 69, 42, 0.14);
  }

  .hito.activo .hito__nodo::before {
    background: var(--acento);
  }

  .hito.activo .hito__cuerpo {
    translate: 0 -4px;
    border-color: var(--tinta);
    box-shadow: 0 34px 60px -34px rgba(23, 20, 15, 0.32);
  }

  /* Cierre de la línea: el pulso descansa en «Hoy». */
  .tiempo__hoy {
    width: max-content;
    margin-left: var(--eje);
    padding-top: 1.1rem;
    translate: -50% 0;
    color: var(--tinta-2);
    transition-property: opacity, transform, color;
  }

  .tiempo__lista.completa + .tiempo__hoy {
    color: var(--acento);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* El año solo se funde: el movimiento lo hacen los dígitos. */
    :global(.js) .hito__anio[data-aparece] {
      transform: none;
    }

    /* La tarjeta entra desde el costado. */
    :global(.js) .hito__cuerpo[data-aparece]:not(.visible) {
      transform: translateX(3rem);
    }

    :global(.js) .hito:not(:has(.hito__cuerpo.visible)) .hito__nodo::before {
      transform: scaleX(0);
    }

    .hito.activo .hito__nodo::after {
      animation: onda 1.6s var(--curva) infinite;
    }
  }

  @media (max-width: 899px) {
    .tiempo__via {
      --pad: 1.75rem;
      --anio: clamp(2.75rem, 12vw, 3.75rem);
      --eje: 0px;
      --nodo-y: calc(var(--pad) + var(--anio) * 0.4);
    }

    .hito {
      grid-template-columns: 1fr;
      padding-left: 1.75rem;
    }

    .hito__nodo::before {
      display: none;
    }

    .hito__anio,
    .hito__cuerpo {
      grid-column: 1 / -1;
      margin-left: 0;
      text-align: left;
    }

    .hito__anio {
      flex-direction: row;
      align-items: baseline;
      gap: 1rem;
      padding: 0;
    }

    .hito__cuerpo {
      margin-top: 1.25rem;
    }

    .tiempo__hoy {
      translate: none;
      padding-left: 1.75rem;
      padding-top: 0;
      margin-top: -0.5rem;
    }

    @media (prefers-reduced-motion: no-preference) {
      :global(.js) .hito__cuerpo[data-aparece]:not(.visible) {
        transform: translateX(1.5rem);
      }
    }
  }

  /* ---------- Cursos ----------
     El comportamiento de la fila (entrada y respuesta al cursor) es el de la
     clase global "fila-viva", en movimiento.css. */
  .tabla__fila {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 5fr) minmax(0, 3fr);
    column-gap: var(--canal);
    align-items: center;
    padding-block: 1.35rem;
  }

  .tabla__anio {
    font-weight: 300;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: lining-nums tabular-nums;
    transition: color 0.6s ease;
  }

  .tabla__fila:hover .tabla__anio {
    color: var(--acento);
  }

  @media (max-width: 699px) {
    .tabla__fila {
      grid-template-columns: 1fr;
      row-gap: 0.4rem;
    }
  }

  /* ---------- Certificaciones: tarjetas con sello que se dibuja ---------- */
  .certs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--canal);
  }

  .cert__sello {
    margin-bottom: 0.5rem;
    fill: none;
    stroke: var(--acento);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cert__sello circle {
    transform: rotate(-90deg);
    transform-origin: center;
  }

  .cert__vigencia {
    align-self: flex-start;
    margin-top: auto;
  }

  .cert .tenue {
    margin-bottom: 0.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .cert__sello circle,
    :global(.js) .cert__sello path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    :global(.js) .cert.visible .cert__sello circle {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 1.1s var(--curva) calc(var(--i, 0) * 55ms + 0.25s);
    }

    :global(.js) .cert.visible .cert__sello path {
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 0.55s var(--curva) calc(var(--i, 0) * 55ms + 1s);
    }
  }

  /* ---------- Sociedades: píldoras ---------- */
  .sociedades {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .sociedad {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.95rem 1.5rem 0.95rem 1.25rem;
    border: 1px solid var(--linea-suave);
    border-radius: 999px;
    background: var(--superficie);
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    transition:
      opacity 0.65s var(--curva) calc(var(--i, 0) * 55ms),
      transform 0.65s var(--curva) calc(var(--i, 0) * 55ms),
      translate var(--hover),
      border-color var(--hover),
      box-shadow var(--hover);
  }

  .sociedad:hover {
    translate: 0 -4px;
    border-color: var(--tinta);
    box-shadow: 0 22px 40px -26px rgba(23, 20, 15, 0.35);
  }

  .sociedad__punto {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--acento);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .sociedad[data-aparece]:not(.visible) {
      transform: translateY(1rem) scale(0.92);
    }
  }

  @media (max-width: 560px) {
    .sociedad {
      border-radius: var(--radio);
    }
  }
</style>
