---
import Base from '../layouts/Base.astro';
import Flecha from '../components/Flecha.astro';
import { paginas } from '../data/sitio';
---

<Base titulo="Página no encontrada" noIndexar conLlamado={false}>
  <section class="perdida marco" aria-labelledby="perdida-titulo">
    <p class="perdida__meta" data-aparece>
      <span class="num">404</span>
      <span class="etiqueta">Página no encontrada</span>
    </p>

    <p class="perdida__numero" aria-hidden="true">
      <span class="renglon" style="--i:0"><span class="renglon__in">4<em>0</em>4</span></span>
    </p>

    <div class="perdida__pie grilla">
      <div class="perdida__texto" data-aparece style="--i:2">
        <h1 class="titulo-m" id="perdida-titulo">Esta página no figura en el índice.</h1>
        <p class="texto tenue">
          Puede que el enlace esté mal escrito o que la página ya no exista. Desde acá podés volver al inicio o ir
          directo a lo que buscabas.
        </p>
        <a class="cta" href="/">
          Volver al inicio
          <Flecha />
        </a>
      </div>

      <nav class="perdida__indice" aria-label="Secciones del sitio" data-aparece style="--i:3">
        <ol class="filas">
          {
            paginas.map((p) => (
              <li>
                <a class="perdida__fila" href={p.ruta}>
                  <span class="num">{p.numero}</span>
                  <span class="titulo-s">{p.nombre}</span>
                  <Flecha />
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </section>
</Base>

<style>
  .perdida {
    padding-top: clamp(1.5rem, 3vw, 3rem);
    padding-bottom: var(--aire);
  }

  .perdida__meta {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }

  .perdida__numero {
    font-family: var(--serif);
    font-weight: 300;
    font-optical-sizing: auto;
    font-size: clamp(6.5rem, min(20vw, 32svh), 20rem);
    line-height: 0.78;
    letter-spacing: -0.07em;
    font-variant-numeric: lining-nums;
    margin-left: -0.04em;
    padding-block: clamp(1rem, 2.5vw, 2.5rem);
  }

  .perdida__numero em {
    color: var(--acento);
  }

  .perdida__pie {
    row-gap: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--linea);
    align-items: start;
  }

  .perdida__texto {
    grid-column: 1 / 6;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .perdida__indice {
    grid-column: 8 / -1;
  }

  .perdida__fila {
    display: grid;
    grid-template-columns: 2.5rem 1fr 1.25rem;
    align-items: baseline;
    padding-block: 0.9rem;
    text-decoration: none;
  }

  .perdida__fila :global(.flecha) {
    align-self: center;
    opacity: 0.35;
    transition:
      transform 0.6s var(--curva),
      opacity 0.6s ease;
  }

  .perdida__fila:hover :global(.flecha),
  .perdida__fila:focus-visible :global(.flecha) {
    opacity: 1;
  }

  @media (max-width: 899px) {
    .perdida__texto,
    .perdida__indice {
      grid-column: 1 / -1;
    }
  }
</style>
