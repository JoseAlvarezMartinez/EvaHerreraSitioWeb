---
import Base from '../layouts/Base.astro';
import Folio from '../components/Folio.astro';
import Seccion from '../components/Seccion.astro';
import { pagina } from '../data/sitio';
import { experiencia } from '../data/experiencia';

const p = pagina('experiencia');
const dos = (n: number) => String(n).padStart(2, '0');
---

<Base titulo={p.nombre} descripcion={p.descripcion} actual="experiencia">
  <Folio numero={p.numero} nombre={p.nombre} titulo={p.titulo} enfasis={p.enfasis} intro={experiencia.intro} />

  <Seccion numero={`${p.numero}.1`} titulo="Trayectoria" id="trayectoria">
    <ol class="filas trayectoria">
      {
        experiencia.trayectoria.map((t, i) => (
          <li class="trayectoria__fila" data-aparece data-linea style={`--i:${i % 3}`}>
            <p class="trayectoria__periodo etiqueta">{t.periodo}</p>
            <div class="trayectoria__cuerpo">
              <h3 class="titulo-m">{t.cargo}</h3>
              <p class="trayectoria__inst">{t.institucion}</p>
              {t.detalle && <p class="texto chico tenue">{t.detalle}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </Seccion>

  <Seccion numero={`${p.numero}.2`} titulo="Instituciones" id="instituciones">
    <ul class="instituciones">
      {
        experiencia.instituciones.map((nombre, i) => (
          <li class="titulo-l" data-palabras style={`--i:${i * 2}`}>
            {nombre}
          </li>
        ))
      }
    </ul>
  </Seccion>

  <Seccion numero={`${p.numero}.3`} titulo="Áreas de práctica" id="areas">
    <ul class="areas">
      {
        experiencia.areas.map((a, i) => (
          <li class="area tarjeta" data-aparece style={`--i:${i % 2}`}>
            <span class="num">{dos(i + 1)}</span>
            <h3 class="titulo-s">{a.nombre}</h3>
            <p class="chico tenue">{a.descripcion}</p>
          </li>
        ))
      }
    </ul>
  </Seccion>

  <Seccion numero={`${p.numero}.4`} titulo="Procedimientos" id="procedimientos">
    <div class="procedimientos">
      {
        experiencia.procedimientos.map((g, i) => (
          <div class="procedimientos__grupo" data-aparece style={`--i:${i}`}>
            <h3 class="etiqueta">{g.grupo}</h3>
            <ul class="filas">
              {g.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="procedimientos__nota chico tenue texto" data-aparece>{experiencia.notaProcedimientos}</p>
  </Seccion>

  {
    experiencia.docencia.length > 0 && (
      <Seccion numero={`${p.numero}.5`} titulo="Docencia" id="docencia">
        <ul class="filas docencia">
          {experiencia.docencia.map((d, i) => (
            <li class="docencia__fila" data-aparece data-linea style={`--i:${i % 3}`}>
              <span class="etiqueta tenue">{d.periodo}</span>
              <span class="titulo-s">{d.actividad}</span>
              <span class="chico tenue">{d.institucion}</span>
            </li>
          ))}
        </ul>
      </Seccion>
    )
  }
</Base>

<style>
  /* ---------- Trayectoria ---------- */
  .trayectoria__fila {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 7fr);
    column-gap: var(--canal);
    padding-block: clamp(1.25rem, 2vw, 2rem);
  }

  .trayectoria__periodo {
    padding-top: 0.75em;
    white-space: nowrap;
  }

  .trayectoria__cuerpo {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  @media (max-width: 699px) {
    .trayectoria__fila {
      grid-template-columns: 1fr;
      row-gap: 0.75rem;
    }

    .trayectoria__periodo {
      padding-top: 0;
      color: var(--tinta-2);
    }
  }

  /* ---------- Instituciones ---------- */
  .instituciones li + li {
    margin-top: 0.18em;
  }


  /* ---------- Áreas ---------- */
  .areas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--canal);
  }

  .area {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: 0.5rem;
    row-gap: 0.4rem;
    align-items: baseline;
  }

  .area p {
    grid-column: 2;
    max-width: 26em;
  }

  @media (max-width: 699px) {
    .areas {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Procedimientos ---------- */
  .procedimientos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--canal);
    row-gap: 3rem;
  }

  .procedimientos__grupo h3 {
    padding-bottom: 1rem;
  }

  .procedimientos__grupo .filas {
    border-top: 1px solid var(--tinta);
  }

  .procedimientos__grupo .filas li:first-child {
    border-top: 0;
  }

  .procedimientos__grupo li {
    padding-block: 0.8rem;
    font-size: 0.9375rem;
  }

  .procedimientos__nota {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  @media (max-width: 799px) {
    .procedimientos {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Docencia ---------- */
  .docencia__fila {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 4fr) minmax(0, 3fr);
    column-gap: var(--canal);
    align-items: baseline;
    padding-block: 1.25rem;
  }

  @media (max-width: 699px) {
    .docencia__fila {
      grid-template-columns: 1fr;
      row-gap: 0.3rem;
    }
  }
</style>
